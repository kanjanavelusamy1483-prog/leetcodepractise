class Solution:
    def getPermutation(self, n: int, k: int) -> str:
        numbers = [str(i) for i in range(1, n + 1)]
        result = []

        factorial = 1
        for i in range(1, n):
            factorial *= i

        k -= 1

        while numbers:
            index = k // factorial
            result.append(numbers.pop(index))

            if not numbers:
                break

            k %= factorial
            factorial //= len(numbers)

        return "".join(result)
